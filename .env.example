# انسخ القيم الجديدة فقط إلى .env المحلي. لا تحفظ .env في Git.
AI_KEY=

# اختياري: مزود ونموذج OpenRouter والمهلة بالثواني.
AI_URL=https://openrouter.ai/api/v1/chat/completions
AI_MODEL=google/gemini-2.5-flash
AI_TIMEOUT=45

# مطلوب في الإنتاج لحماية مسارات الإدارة. استخدم قيمة طويلة وعشوائية.
ADMIN_TOKEN=

# يبقى معطلاً افتراضياً. لا تفعّله إلا مؤقتاً في بيئة إدارة موثوقة.
ENABLE_GIT_PUSH=false

# نطاقات الواجهة المسموح لها باستدعاء API، مفصولة بفواصل.
ALLOWED_ORIGINS=http://127.0.0.1:5000,http://localhost:5000

# اختياري: بريد مسؤول السحب ليظهر في User-Agent المعلن.
SCRAPER_CONTACT_EMAIL=
